# Anonimus Backend — Environment Variables
# Copy this to .env and fill in values

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

# Network: 'local' or 'preprod'
MIDNIGHT_NETWORK=preprod

# ============================================================================
# WALLET CONFIGURATION
# ============================================================================

# Deployer wallet mnemonic (64-character hex string, no 0x prefix)
# This wallet is used for:
# - Contract deployment
# - Verifier registration (admin operation)
# - Credential enrollment (admin operation)
#
# WARNING: Never commit this value to source control.
# Generate with: openssl rand -hex 32
DEPLOYER_WALLET_SECRET=

# Contract address on preprod (set after deployment)
# Leave empty to deploy a new contract
MIDNIGHT_CONTRACT_ADDRESS=

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server port
PORT=3001

# CORS origin (your Vercel frontend URL)
CORS_ORIGIN=https://anonimus-proof.vercel.app

# ============================================================================
# SECURITY
# ============================================================================

# Private state encryption password
# CHANGE THIS to a strong, unique password for production
PRIVATE_STATE_PASSWORD=CHANGE-ME-IN-PRODUCTION

# ============================================================================
# SUPABASE (optional - for persistent storage)
# ============================================================================

# Supabase project URL
SUPABASE_URL=

# Supabase anon key (safe for client-side, but we only use it server-side)
SUPABASE_ANON_KEY=

# Supabase service role key (server-side only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# PROOF SERVER (optional - for local proof generation)
# ============================================================================

# Proof server URL (default: http://127.0.0.1:6300)
# Only needed if running a local proof server
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300

# ============================================================================
# WALLET STATE (optional - for fast sync)
# ============================================================================

# Reference bundle root for fast wallet sync
FAST_SYNC_REFERENCE_ROOT=

# Saved wallet state directory (default: /opt/anonimus/wallet-state)
WALLET_STATE_DIR=/opt/anonimus/wallet-state
